{
  "name": "error-bot",
  "version": "1.0.0",
  "description": "A telegram relay bot for error messaging",
  "engines": {
    "node": ">=24"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "docker": "docker build . -t nonhumannonsense/error-bot:latest --platform linux/amd64",
    "push": "docker push nonhumannonsense/error-bot:latest"
  },
  "author": "Nonhuman Nonsense",
  "license": "CC BY-NC 4.0",
  "dependencies": {
    "dockerode": "^5.0.1",
    "express": "^5.3.0",
    "telegraf": "^4.16.3"
  }
}

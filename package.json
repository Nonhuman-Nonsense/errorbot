{
  "name": "error-bot",
  "version": "1.0.0",
  "description": "A telegram relay bot for error messaging",
  "engines": {
    "node": ">=24.2"
  },
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "type-check": "tsc",
    "test": "npm run type-check && node --test \"test/*.test.ts\"",
    "docker": "docker build . -t nonhumannonsense/error-bot:latest --platform linux/amd64",
    "push": "docker push nonhumannonsense/error-bot:latest"
  },
  "author": "Nonhuman Nonsense",
  "license": "CC BY-NC 4.0",
  "dependencies": {
    "dockerode": "^5.0.1",
    "express": "^5.3.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
